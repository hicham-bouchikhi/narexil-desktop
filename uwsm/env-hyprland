# ~/.config/uwsm/env
export XDG_CURRENT_DESKTOP=Hyprland:KDE

# Toolkits
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM="wayland;xcb"
export SDL_VIDEODRIVER=wayland
export CLUTTER_BACKEND=wayland

# Theme & Desktop Styling
export QT_QPA_PLATFORMTHEME="qt6ct"
export KDE_FULL_SESSION=true
export KDE_SESSION_VERSION=6
export KDE_SESSION_UID=1000
export XCURSOR_SIZE=24
export HYPRCURSOR_SIZE=24

# NVIDIA Specifics
export LIBVA_DRIVER_NAME=nvidia
export __GLX_VENDOR_LIBRARY_NAME=nvidia
export GBM_BACKEND=nvidia-drm
export NVD_BACKEND=direct

# XDG Paths & Plasma Integration
export XDG_CONFIG_DIRS="/home/esperadoce/.config/kdedefaults:/etc/xdg"
export XDG_DATA_DIRS="/home/esperadoce/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share"
export XDG_MENU_PREFIX=plasma-
export PASSWORD_STORE=kwalletd6

# Application Hints
export ELECTRON_OZONE_PLATFORM_HINT=wayland